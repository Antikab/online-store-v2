{
  "name": "online-store-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "engines": {
    "node": "^22.23.1 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --no-fix --no-cache",
    "test": "vitest run",
    "format": "prettier --write src/",
    "supabase:types": "npx supabase gen types typescript --project-id fcdsigcrcbupqnbsbwwf --schema public > src/shared/api/supabase/database.types.ts",
    "fsd": "steiger ./src"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-form": "1.33.5",
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-inline-svg": "4.0.1",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.1",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "jiti": "2.7.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "steiger": "0.8.1",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
